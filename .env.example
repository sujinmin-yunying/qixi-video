# test 或 prod；local 由 npm run dev 固定设置，不需要密钥。
APP_ENV=test
PORT=4173

# openai 或 ark
IMAGE_PROVIDER=openai
OCR_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini

# 火山引擎可选配置
ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_IMAGE_MODEL=doubao-seedream-3-0-t2i-250415
ARK_IMAGE_SIZE=1536x2560
ARK_VISION_MODEL=doubao-1-5-vision-pro-32k-250115
